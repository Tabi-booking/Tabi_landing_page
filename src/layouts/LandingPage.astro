---
import type { Locale } from '../i18n/types';
import BaseLayout from './BaseLayout.astro';
import SectionGroup from '../components/layout/SectionGroup.astro';
import { getContent } from '../i18n';
import { Hero } from '../components/sections/Hero';
import { HowItWorks } from '../components/sections/HowItWorks';
import { ForClients } from '../components/sections/ForClients';
import { ForRestaurants } from '../components/sections/ForRestaurants';
import { Demo } from '../components/sections/Demo';
import { Testimonials } from '../components/sections/Testimonials';
import { Pricing } from '../components/sections/Pricing';
import { FAQ } from '../components/sections/FAQ';
import { ContactForm } from '../components/sections/ContactForm';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
---

<BaseLayout locale={locale} content={content}>
  <Hero client:load content={content.hero} />

  <SectionGroup divider={false}>
    <HowItWorks client:visible content={content.howItWorks} />
    <ForClients client:visible content={content.forClients} />
    <Demo client:visible content={content.demo} />
  </SectionGroup>

  <SectionGroup tone="muted">
    <ForRestaurants client:visible content={content.forRestaurants} />
    <Pricing client:visible content={content.pricing} />
  </SectionGroup>

  <SectionGroup>
    <Testimonials client:visible content={content.testimonials} />
    <FAQ client:visible content={content.faq} />
    <ContactForm
      client:visible
      content={content.contact}
      locale={locale}
      contactPhone={import.meta.env.CONTACT_PHONE ?? content.footer.phone}
    />
  </SectionGroup>
</BaseLayout>
