# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Email address where contact form submissions will be delivered
# With a verified domain you can use any inbox (Gmail, iCloud, hola@tabiapp.tech, etc.)
# After editing this file, restart `npm run dev` — shell env vars override .env files
CONTACT_EMAIL=tu@email.com

# Business phone shown in footer and contact section
CONTACT_PHONE=+57 300 123 4567

# Sender address — must use your verified domain (tabiapp.tech)
RESEND_FROM_EMAIL=Tabi <hola@tabiapp.tech>

# --- Vercel ---
# Add the variables above in: Project Settings → Environment Variables
# Apply to Production (and Preview if you want the contact form in PR previews).
